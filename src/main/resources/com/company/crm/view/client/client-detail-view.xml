<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://clientDetailView.title"
      focusComponent="form">
    <data>
        <instance id="clientDc"
                  class="com.company.crm.entity.Client">
            <fetchPlan extends="_base">
                <property name="accountManager" fetchPlan="_instance_name"/>
                <property name="contacts" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="clientDl"/>
            <collection id="contactsDc" property="contacts"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <!-- tag::report-actions[] -->
    <actions>
        <!-- ... -->
        <!-- end::report-actions[] -->
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
        <!-- tag::report-actions[] -->
        <action id="runSingleEntityReportAction" text="Reports for entity"
                type="report_runSingleEntityReport"/> <!--1-->
    </actions>
    <layout>
        <!-- end::report-actions[] -->
        <tabSheet width="100%">
            <tab id="infoTab" label="Info">
                <formLayout id="form" dataContainer="clientDc">
                    <responsiveSteps>
                        <responsiveStep minWidth="0" columns="1"/>
                        <responsiveStep minWidth="40em" columns="2"/>
                    </responsiveSteps>
                    <textField id="nameField" property="name"/>
                    <textField id="fullNameField" property="fullName"/>
                    <textField id="addressField" property="address"/>
                    <select id="typeField" property="type"/>
                    <textField id="vatNumberField" property="vatNumber"/>
                    <textField id="regNumberField" property="regNumber"/>
                    <textField id="websiteField" property="website"/>
                    <entityPicker id="accountManagerField" property="accountManager">
                        <actions>
                            <action id="entityLookupAction" type="entity_lookup"/>
                            <action id="entityClearAction" type="entity_clear"/>
                        </actions>
                    </entityPicker>
                </formLayout>
            </tab>
            <tab id="contactsTab" label="Contacts">
                <vbox id="contactsTabContent" padding="false">
                    <hbox id="contactsButtonsPanel" classNames="buttons-panel">
                        <button action="contactsDataGrid.createAction"/>
                        <button action="contactsDataGrid.editAction"/>
                        <button action="contactsDataGrid.removeAction"/>
                    </hbox>
                    <dataGrid id="contactsDataGrid" dataContainer="contactsDc" width="100%" minHeight="20em">
                        <actions>
                            <action id="createAction" type="list_create">
                                <properties>
                                    <property name="openMode" value="DIALOG"/>
                                </properties>
                            </action>
                            <action id="editAction" type="list_edit">
                                <properties>
                                    <property name="openMode" value="DIALOG"/>
                                </properties>
                            </action>
                            <action id="removeAction" type="list_remove"/>
                        </actions>
                        <columns>
                            <column property="person"/>
                            <column property="position"/>
                            <column property="startDate"/>
                            <column property="finishDate"/>
                            <column property="phone"/>
                            <column property="email"/>
                        </columns>
                    </dataGrid>
                </vbox>
            </tab>
        </tabSheet>
        <!-- tag::report-actions[] -->
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
            <button action="runSingleEntityReportAction"/> <!--1-->
            <button id="printClientProfileButton" text="Print client profile"
                    icon="vaadin:file-text"/> <!--2-->
        </hbox>
    </layout>
    <!-- end::report-actions[] -->
</view>
